{
  "name": "shared-ssh-terminal",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Local shared SSH terminal with browser and MCP clients",
  "bin": { "shared-ssh-terminal": "dist/cli.js" },
  "engines": { "node": ">=22" },
  "files": [
    "dist/*.js", "skill/*.md", "public/", "scripts/ssh-askpass.cs", "docs/*.md", "AGENTS.md", "CLAUDE.md",
    "start.cmd", "stop.cmd", "Start-Terminal.ps1", "Stop-Terminal.ps1", "Register-MCP.ps1"
  ],
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/cli.js server",
    "mcp": "node dist/cli.js mcp",
    "prepack": "tsc",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs",
    "check:docs": "tsx docs/check-index.ts",
    "check:publish": "node scripts/check-publish.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "jsonc-parser": "^3.3.1",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.9.1",
    "ws": "^8.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.0",
    "ssh2": "^1.17.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}

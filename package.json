{
  "name": "shared-ssh-terminal",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Local shared SSH terminal with browser and MCP clients",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "mcp": "node dist/mcp.js",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs",
    "check:docs": "tsx docs/check-index.ts",
    "check:publish": "node scripts/check-publish.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0",
    "ws": "^8.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.0",
    "ssh2": "^1.17.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
